# Environment configuration for InfraWatch v3
# Optional — If left blank, InfraWatch automatically generates cryptographically
# secure 64-hex tokens on first run and persists them to alarm/.api_key and alarm/.webhook_secret.

# Optional override — protects all state-changing /api/* endpoints (X-API-Key header
# or "Authorization: Bearer <key>").
INFRAWATCH_API_KEY=

# Optional override — protects POST /webhook. Send the secret in the
# X-Webhook-Secret request header (a ?secret= query string is NOT accepted —
# it would leak via proxy/access logs and Referer). Configure Alertmanager's
# webhook_configs with http_config.authorization or a custom header.
WEBHOOK_SECRET=

# URL of your (external) Prometheus. Leave blank to start with no endpoint and
# add it later in the UI (Manage Prometheus Endpoints). A non-blank value is
# seeded once on first run and used as the failover fallback.
PROMETHEUS_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# Session cookie Secure flag. 0 for a plain-HTTP LAN install (default in
# docker-compose) — a Secure cookie is dropped by the browser over http:// and
# login won't persist. Set to 1 only when served behind HTTPS.
SESSION_COOKIE_SECURE=0

